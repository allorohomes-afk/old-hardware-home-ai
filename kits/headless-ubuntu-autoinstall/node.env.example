# Copy to node.env and edit. node.env is ignored by git: it describes YOUR machine and network.
NODE_HOSTNAME=ai-node-1
NODE_USER=ai
TIMEZONE=Etc/UTC                # e.g. America/Chicago, Europe/Berlin
LAN_CIDR=192.168.1.0/24         # your home network; SSH is allowed from here only
DISK_MODEL='WDC*'               # model of the disk to WIPE, as a glob. Check it on the target machine first.
ISO=$HOME/Downloads/ubuntu-24.04.5-live-server-amd64.iso
KEY=$HOME/.ssh/id_ed25519.pub   # the SSH public key that may log in
OUT=$HOME/.ai-node              # where the password hash and the built ISO go (outside git)

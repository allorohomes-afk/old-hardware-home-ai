# Pinned versions for the Pascal lifeline kit. Every script reads this file.
# Change one thing at a time, then re-run build-llama.sh: it fails if the result no longer runs on Pascal.

# NVIDIA's 580 branch is the last driver branch that supports Pascal (GTX 10-series, Tesla P4/P40/P100).
DRIVER_BRANCH=580

# CUDA 12.9 is the last toolkit that can build for Pascal. CUDA 13 dropped it.
CUDA_VERSION=12.9.1
CUDA_RUNFILE=cuda_12.9.1_575.57.08_linux.run
CUDA_URL=https://developer.download.nvidia.com/compute/cuda/12.9.1/local_installers/cuda_12.9.1_575.57.08_linux.run
CUDA_MD5=a52d6c204bd4268627dfdab8bfeeb0d1   # published by NVIDIA: .../12.9.1/docs/sidebar/md5sum.txt
CUDA_SHA256=0f6d806ddd87230d2adbe8a6006a9d20144fdbda9de2d6acc677daa5d036417a  # measured by us, 2026-11-15

# llama.cpp: the release we benchmark with, pinned to its exact commit.
LLAMA_TAG=b11669
LLAMA_COMMIT=620d2225cc436ab0b001e3200e590e3b286ef9ab

# GPU code to build: 60 = Tesla P100, 61 = GTX 10-series, Titan X/Xp, Tesla P4/P40, Quadro P-series.
# (62 is the Jetson TX2, an ARM board, and is left out.)
CUDA_ARCHS="60;61"
